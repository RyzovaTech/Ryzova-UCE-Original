# Ryzova UCE — illustrative MCP configuration names, not a runnable deployment.
# These are documented operator knobs, not UCE product/paid-plan limits.
# Never commit real credentials or import this example verbatim in production.
# Local plugin runner: authorize only a dedicated project directory.
UCE_MCP_AUTHORIZED_ROOT=/absolute/path/to/approved-projects
# For a plugin installed independently of its source checkout, point at a
# separately installed complete, pinned Ryzova UCE repository checkout.
UCE_ENGINE_ROOT=/absolute/path/to/ryzova-uce-original

# Private loopback HTTP development gateway. No internet-facing listener.
UCE_MCP_PORT=8715
UCE_MCP_ALLOWED_ORIGINS=https://your-private-host.example
UCE_MCP_ENABLE_UPLOAD_UI=0
# ACCOUNT JSON contains a per-user precomputed token SHA-256 or OAuth subject
# and an isolated root. Configure secret-bearing JSON in a secret manager.
UCE_MCP_ACCOUNTS_JSON=[]

# Remote mode blocks local privileged tools; do not turn off on shared hosts.
UCE_MCP_REMOTE_UPLOAD_ONLY=1
UCE_MCP_GIT_HOSTS=github.com,gitlab.com,codeberg.org

# Runtime resource policies: operator-configurable, no UCE subscription tiers.
UCE_MCP_MAX_JOBS=100
UCE_MCP_MAX_CONCURRENT_SCANS=2
UCE_MCP_MAX_CACHED_REPORTS=100
UCE_MCP_MAX_REPORT_BYTES=8388608
UCE_MCP_MAX_SCAN_FILES=25000
UCE_MCP_MAX_SCAN_BYTES=100663296
# Dedicated temporary job root is set internally by the worker supervisor.
UCE_MCP_WORK_ROOT=/absolute/dedicated/temp/session

# OAuth metadata + JWT verification require independent reviewed issuer/JWKS.
# Store UCE_MCP_OAUTH_CONFIG as a secret JSON value, not in a checked-in file.
# PATH is inherited from the host OS and must not be overwritten by this file.
