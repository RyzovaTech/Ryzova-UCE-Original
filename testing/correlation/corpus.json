{
  "schemaVersion": 1,
  "name": "Phase 4 package-local correlation development contracts",
  "scope": "Synthetic contract labels, agent-provisional, no independent adjudication or global accuracy claim.",
  "cases": [
    {
      "id": "runtime-caret-mismatch",
      "family": "runtime",
      "ecosystem": "nodejs",
      "files": [
        {
          "path": "package.json",
          "content": "{\"engines\": {\"node\": \"^20.2.0\"}}"
        },
        {
          "path": ".nvmrc",
          "content": "22.0.0"
        }
      ],
      "expected": true,
      "rationale": "Review only disjoint supported numeric selections in the same package."
    },
